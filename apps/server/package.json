{
  "name": "@repo/server",
  "version": "0.1.0",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.4",
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/testing": "^0.18.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "eslint": "^10.6.0",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.43",
    "@colyseus/tools": "^0.18.11",
    "colyseus": "^0.18.10",
    "express": "^5.3.0",
    "@repo/core": "workspace:*"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  }
}
