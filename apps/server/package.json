{
  "name": "@repo/server",
  "version": "0.1.0",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.8",
    "@colyseus/sdk": "^0.17.42",
    "@colyseus/testing": "^0.17.11",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.26",
    "@colyseus/tools": "^0.17.19",
    "colyseus": "^0.17.10",
    "express": "^4.18.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  }
}
